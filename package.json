{
  "name": "@antora-supplemental/orphan-finder",
  "version": "0.1.0",
  "description": "CLI (+ optional Antora extension): find unresolved include:: and attribute refs + unused; JSON + triage HTML",
  "license": "MIT",
  "author": "Ryan Johnson (https://github.com/AMDphreak)",
  "keywords": [
    "antora",
    "asciidoc",
    "orphan",
    "include",
    "attributes",
    "triage"
  ],
  "homepage": "https://github.com/antora-supplemental/orphan-finder",
  "bugs": {
    "url": "https://github.com/antora-supplemental/orphan-finder/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antora-supplemental/orphan-finder.git"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./extension": "./lib/extension.js",
    "./registry": "./lib/registry-meta.js"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "orphan-finder": "bin/orphan-finder.js"
  },
  "files": [
    "bin/**/*",
    "lib/**/*",
    "README.adoc",
    "CHANGELOG.adoc",
    "LICENSE",
    "antora-registry.md"
  ],
  "dependencies": {
    "@antora-supplemental/triage-ux-kit": "github:antora-supplemental/triage-ux-kit#v0.1.0"
  },
  "peerDependencies": {
    "@antora/site-generator": ">=3.1.0"
  },
  "peerDependenciesMeta": {
    "@antora/site-generator": {
      "optional": true
    }
  }
}
